# Mend Unified Agent configuration for TKA-10822 regression test
# https://mend-io.atlassian.net/browse/TKA-10822
#
# This config mirrors the exact toggles Fidelity ran, which are the trigger
# conditions for the bug:
#   - python.resolveHierarchyTree=true   -> scanner installs pipdeptree, which
#                                           pulls nab-index (urllib3>=2.0) and
#                                           upgrades the venv's urllib3 to 2.7.0
#   - python.ignorePipInstallErrors=true -> customer's standard, supported setting
#   - python.applyConstraints=false      -> matches the customer's scan
apiKey=
wss.url=

# Python scanning
python.resolveDependencies=true
python.resolveHierarchyTree=true
python.ignorePipInstallErrors=true
python.applyConstraints=false
python.runPipenvPreStep=false

# Project identification
projectName=tka-10822-pipdeptree-urllib3-partial-scan

# Scanner needs PyPI access to install requirements.txt and pipdeptree
offline=false
resolveAllDependencies=false
